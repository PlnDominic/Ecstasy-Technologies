# ── Contact form email (nodemailer) ──
# Required for /api/contact (the "Send Message" form on /contact) to
# actually deliver mail. Any standard SMTP provider works — Gmail (with an
# App Password), Zoho Mail, SendGrid SMTP, Resend SMTP, etc.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS).
# Defaults to true only when SMTP_PORT=465, so this can usually be omitted.
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Where contact form submissions are delivered to.
# Defaults to support@ecstasytechnologies.com if unset.
CONTACT_TO_EMAIL=support@ecstasytechnologies.com

# "From" address on the outgoing mail. Defaults to SMTP_USER if unset —
# set this explicitly if SMTP_USER isn't a mailbox you want visible as
# the sender (some providers require the From address to match the
# authenticated account, so check your provider's rules first).
CONTACT_FROM_EMAIL=you@example.com

# ── Scheduled X (Twitter) posting — currently PAUSED ──
# The code path is built and verified working end-to-end, but there is no
# vercel.json cron entry calling it right now, so nothing posts
# automatically. Resuming it requires the X developer project to be on a
# paid/Pay-Per-Use plan — that tradeoff hasn't been made yet. These vars
# are only needed if/when it's turned back on. Generate them under your X
# app's "Keys and tokens" tab — OAuth 1.0 Keys section — with the app set
# to "Read and write" permissions. See src/lib/x.ts and
# src/app/api/cron/post-x/route.ts.
X_API_KEY=your-consumer-key
X_API_SECRET=your-consumer-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_TOKEN_SECRET=your-access-token-secret

# Shared secret that locks down /api/cron/post-x so only Vercel's cron
# invoker can trigger a real post. Generate any long random string
# (e.g. `openssl rand -hex 32`) and set the same value here and in your
# Vercel project's environment variables — Vercel automatically sends it
# as a Bearer token on scheduled invocations once CRON_SECRET is set.
CRON_SECRET=a-long-random-string
