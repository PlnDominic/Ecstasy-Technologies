# ── Contact form email (nodemailer) ──
# Required for /api/contact (the "Send Message" form on /contact) to
# actually deliver mail. Any standard SMTP provider works — Gmail (with an
# App Password), Zoho Mail, SendGrid SMTP, Resend SMTP, etc.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS).
# Defaults to true only when SMTP_PORT=465, so this can usually be omitted.
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Where contact form submissions are delivered to.
# Defaults to support@ecstasytechnologies.com if unset.
CONTACT_TO_EMAIL=support@ecstasytechnologies.com

# "From" address on the outgoing mail. Defaults to SMTP_USER if unset —
# set this explicitly if SMTP_USER isn't a mailbox you want visible as
# the sender (some providers require the From address to match the
# authenticated account, so check your provider's rules first).
CONTACT_FROM_EMAIL=you@example.com
